SERVICE_NAME=auth-service
SERVICE_PORT=8001
SPRING_PROFILES_ACTIVE=dev
CONFIG_SERVER_URL=http://localhost:8888

# Base de données auth_db (port hôte 5433 en dev, postgres-auth:5432 en docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# Sécurité JWT & chiffrement embeddings faciaux
JWT_SECRET_KEY=change-me-in-production-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FACE_ENCRYPTION_KEY=change-me-fernet-key-32-bytes-base64==

# Eureka & Kafka
EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# WebAuthn (empreinte & code/mot de passe du téléphone)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CampusConnect
WEBAUTHN_ORIGIN=http://localhost:8080